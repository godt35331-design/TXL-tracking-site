# Port for Express API Server
PORT=5000

# MongoDB Atlas Connection String (Replace with your new MongoDB database connection)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/txl_portal?retryWrites=true&w=majority

# Admin Login Credentials
ADMIN_EMAIL=admin@txlglobaltracking.com
ADMIN_PASSWORD=admin123

# Domain & Email Configuration
PORTAL_DOMAIN=txlglobaltracking.com
FROM_EMAIL=TXL Express Support <support@txlglobaltracking.com>

# Resend API Key for Email Notifications
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
